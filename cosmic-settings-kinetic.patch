+fn per_app_scroll() -> Section<crate::pages::Message> {
+    crate::slab!(descriptions {
+        _title = fl!("per-app-scroll");
+        desc = fl!("per-app-scroll", "desc");
+        app_id = fl!("per-app-scroll", "app-id");
+        factor = fl!("per-app-scroll", "factor");
+        add = fl!("per-app-scroll", "add");
+        add_window = fl!("per-app-scroll", "add-window");
+        no_windows = fl!("per-app-scroll", "no-windows");
+    });
+
+    Section::default()
+        .title(fl!("per-app-scroll"))
+        .descriptions(descriptions)
+        .view::<Page>(move |binder, _page, section| {
+            let descriptions = &section.descriptions;
+            let page = binder
+                .page::<super::Page>()
+                .expect("input devices page not found");
+
+            let mut list = settings::section()
+                .title(&section.title)
+                .add(text::body(&descriptions[desc]));
+
+            for (index, entry) in page.per_app_scroll.iter().enumerate() {
+                list = list.add(settings::item_row(vec![
+                    widget::text_input::text_input(
+                        descriptions[app_id].as_str(),
+                        entry.app_id.as_str(),
+                    )
+                    .on_input(move |value| Message::PerAppScrollAppId(index, value))
+                    .width(Length::Fill)
+                    .into(),
+                    widget::text_input::text_input(
+                        descriptions[factor].as_str(),
+                        entry.factor.as_str(),
+                    )
+                    .on_input(move |value| Message::PerAppScrollFactor(index, value))
+                    .width(Length::Fixed(96.0))
+                    .into(),
+                    widget::button::icon(widget::icon::from_name("edit-delete-symbolic"))
+                        .on_press(Message::PerAppScrollRemove(index))
+                        .into(),
+                ]));
+            }
+
+            list = list.add(
+                row::with_capacity(2)
+                    .spacing(8)
+                    .push(
+                        widget::button::standard(&descriptions[add])
+                            .leading_icon(widget::icon::from_name("list-add-symbolic"))
+                            .on_press(Message::PerAppScrollAdd),
+                    )
+                    .push(
+                        widget::button::standard(&descriptions[add_window])
+                            .leading_icon(widget::icon::from_name("window-new-symbolic"))
+                            .on_press(Message::PerAppScrollTogglePicker),
+                    ),
+            );
+
+            // Open-window picker: one button per running application whose
+            // app id doesn't already have an override row.
+            if page.window_picker_open {
+                let mut shown = 0;
+                for (index, window) in page.open_windows.iter().enumerate() {
+                    if page
+                        .per_app_scroll
+                        .iter()
+                        .any(|entry| entry.app_id.trim() == window.app_id)
+                    {
+                        continue;
+                    }
+                    shown += 1;
+
+                    let label = if window.title.is_empty() {
+                        window.app_id.clone()
+                    } else {
+                        format!("{} — {}", window.app_id, window.title)
+                    };
+
+                    list = list.add(
+                        widget::button::text(label)
+                            .on_press(Message::PerAppScrollPickWindow(index)),
+                    );
+                }
+
+                if shown == 0 {
+                    list = list.add(text::body(&descriptions[no_windows]));
+                }
+            }
+
+            list.apply(Element::from).map(crate::pages::Message::Input)
+        })
+}
