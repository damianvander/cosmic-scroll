diff --git a/cosmic-settings/src/pages/input/window_picker.rs b/cosmic-settings/src/pages/input/window_picker.rs
new file mode 100644
index 0000000000000000000000000000000000000000..84f1915bd524f841cb09e7a4e839e23223881592
--- /dev/null
+++ b/cosmic-settings/src/pages/input/window_picker.rs
@@ -0,0 +1,165 @@
+// Copyright 2026 System76 <info@system76.com>
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! One-shot query of the currently open windows via the
+//! `ext-foreign-toplevel-list-v1` Wayland protocol. Used by the per-app
+//! scroll-speed section so users can pick an open window instead of typing
+//! its app id by hand.
+
+use cosmic::cctk::wayland_client::{
+    Connection, Dispatch, Proxy, QueueHandle,
+    globals::{GlobalListContents, registry_queue_init},
+    protocol::wl_registry,
+};
+use cosmic::cctk::wayland_protocols::ext::foreign_toplevel_list::v1::client::{
+    ext_foreign_toplevel_handle_v1::{self, ExtForeignToplevelHandleV1},
+    ext_foreign_toplevel_list_v1::{self, ExtForeignToplevelListV1},
+};
+
+/// An open window, as advertised by the compositor.
+#[derive(Clone, Debug)]
+pub struct WindowInfo {
+    pub app_id: String,
+    pub title: String,
+}
+
+/// Returns the currently open windows, deduplicated by app id and sorted.
+/// Connects to the compositor, collects the initial toplevel burst, and
+/// disconnects; returns an empty list if the compositor does not support
+/// `ext-foreign-toplevel-list-v1` or the connection fails.
+pub fn open_windows() -> Vec<WindowInfo> {
+    query().unwrap_or_else(|why| {
+        tracing::warn!(?why, "failed to enumerate open windows");
+        Vec::new()
+    })
+}
+
+#[derive(Default)]
+struct State {
+    windows: Vec<PendingWindow>,
+}
+
+struct PendingWindow {
+    handle: ExtForeignToplevelHandleV1,
+    app_id: String,
+    title: String,
+    done: bool,
+}
+
+fn query() -> Result<Vec<WindowInfo>, Box<dyn std::error::Error>> {
+    let conn = Connection::connect_to_env()?;
+    let (globals, mut event_queue) = registry_queue_init::<State>(&conn)?;
+    let qh = event_queue.handle();
+
+    let list = globals.bind::<ExtForeignToplevelListV1, _, _>(&qh, 1..=1, ())?;
+
+    let mut state = State::default();
+    // The compositor sends every existing toplevel followed by its
+    // title/app_id and a `done` in the initial burst after binding; two
+    // roundtrips make sure the burst has been fully delivered and handled.
+    event_queue.roundtrip(&mut state)?;
+    event_queue.roundtrip(&mut state)?;
+    list.stop();
+
+    let mut windows: Vec<WindowInfo> = state
+        .windows
+        .into_iter()
+        .filter(|window| window.done && !window.app_id.is_empty())
+        .map(|window| WindowInfo {
+            app_id: window.app_id,
+            title: window.title,
+        })
+        .collect();
+
+    windows.sort_by(|a, b| {
+        a.app_id
+            .to_lowercase()
+            .cmp(&b.app_id.to_lowercase())
+            .then_with(|| a.title.cmp(&b.title))
+    });
+    windows.dedup_by(|a, b| a.app_id == b.app_id);
+
+    Ok(windows)
+}
+
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for State {
+    fn event(
+        _state: &mut Self,
+        _proxy: &wl_registry::WlRegistry,
+        _event: wl_registry::Event,
+        _data: &GlobalListContents,
+        _conn: &Connection,
+        _qh: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+impl Dispatch<ExtForeignToplevelListV1, ()> for State {
+    fn event(
+        state: &mut Self,
+        _proxy: &ExtForeignToplevelListV1,
+        event: ext_foreign_toplevel_list_v1::Event,
+        _data: &(),
+        _conn: &Connection,
+        _qh: &QueueHandle<Self>,
+    ) {
+        if let ext_foreign_toplevel_list_v1::Event::Toplevel { toplevel } = event {
+            state.windows.push(PendingWindow {
+                handle: toplevel,
+                app_id: String::new(),
+                title: String::new(),
+                done: false,
+            });
+        }
+    }
+
+    cosmic::cctk::wayland_client::event_created_child!(State, ExtForeignToplevelListV1, [
+        ext_foreign_toplevel_list_v1::EVT_TOPLEVEL_OPCODE => (ExtForeignToplevelHandleV1, ())
+    ]);
+}
+
+impl Dispatch<ExtForeignToplevelHandleV1, ()> for State {
+    fn event(
+        state: &mut Self,
+        proxy: &ExtForeignToplevelHandleV1,
+        event: ext_foreign_toplevel_handle_v1::Event,
+        _data: &(),
+        _conn: &Connection,
+        _qh: &QueueHandle<Self>,
+    ) {
+        let Some(index) = state
+            .windows
+            .iter()
+            .position(|window| window.handle.id() == proxy.id())
+        else {
+            return;
+        };
+
+        match event {
+            ext_foreign_toplevel_handle_v1::Event::AppId { app_id } => {
+                state.windows[index].app_id = app_id;
+            }
+            ext_foreign_toplevel_handle_v1::Event::Title { title } => {
+                state.windows[index].title = title;
+            }
+            ext_foreign_toplevel_handle_v1::Event::Done => {
+                state.windows[index].done = true;
+            }
+            ext_foreign_toplevel_handle_v1::Event::Closed => {
+                state.windows.remove(index);
+            }
+            _ => {}
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn list_windows() {
+        for w in super::open_windows() {
+            println!("{} — {}", w.app_id, w.title);
+        }
+    }
+
+}
