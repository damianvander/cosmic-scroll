+    /// Update one field of the kinetic-scrolling tunables, creating the
+    /// intermediate config structs on first write.
+    fn update_kinetic<F: Fn(&mut KineticScrollConfig)>(&mut self, touchpad: bool, f: F) {
+        self.update_input(touchpad, |x| {
+            f(x.scroll_config
+                .get_or_insert(ScrollConfig::default())
+                .kinetic_config
+                .get_or_insert(KineticScrollConfig::default()));
